# Copy to .env and fill in. Never commit .env. On the VM these live in /etc/arena/*.env
# (deploy/RUNBOOK.md); each one is listed with the file it goes in.

# /etc/arena/api.env. GitHub OAuth app (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# /etc/arena/api.env. Signs session cookies.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# /etc/arena/caddy.env. The VM's free subdomain, and the secret the Pages proxy sends
# (also set as ORIGIN_SECRET in the Pages project). Generate it like SESSION_SECRET.
ARENA_HOST=
ARENA_ORIGIN_SECRET=

# /etc/arena/backup.env. A Cloud Storage bucket name, not a secret: the VM signs in as its
# own service account.
ARENA_BACKUP_BUCKET=
