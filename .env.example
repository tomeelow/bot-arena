# Copy to .env and fill in. Never commit .env.
# Nothing reads these yet; each one is listed with the phase that introduces it.

# Phase 6: GitHub OAuth app (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Phase 6: signs session cookies.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Phase 9: backups to S3-compatible object storage (Litestream, rclone)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
